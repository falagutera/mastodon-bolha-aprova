# aprova reads its SECRETS from the environment; everything else — which instance,
# which apps are on, roles, mail texts — lives in the YAML config (APROVA_CONFIG,
# see config.example.yaml).
#
# Turning an app on is done in the YAML (list its module under `modules:` and add
# a `services:` block). This file only holds the secret each block names by
# `token_env` / `digest_token_env`: the variable name here must match the YAML.
# That is why nothing below is literally called "mastodon" or "peertube" — the
# names are yours to choose in the config, and these are the defaults it uses.
#
# To boot, only the first three groups are needed (OAuth + a key + the database);
# a plain Mastodon sign-in (auth: moderator) needs no per-app secret.

APROVA_CONFIG=/config/aprova.yaml

# OAuth app on the sign-in instance (register it, see README > Install).
# Scopes: profile, plus admin:read:accounts admin:write:accounts if any service
# uses auth: moderator.
APROVA_CLIENT_ID=
APROVA_CLIENT_SECRET=
# Encrypts the moderators' tokens at rest: openssl rand -hex 32
APROVA_ENCRYPTION_KEY=

# Database. With the bundled docker-compose.yml, Postgres is created from these.
APROVA_DB_HOST=postgres
APROVA_DB_PASSWORD=change-me
# Postgres superuser password, used only by the bundled docker-compose.yml to
# create the database and the limited app role. The app never uses it.
POSTGRES_SUPERUSER_PASSWORD=change-me-too
#APROVA_DB_PORT=5432
#APROVA_DB_USER=aprova
#APROVA_DB_NAME=aprova
#APROVA_DB_SSLMODE=prefer

# E-mail to applicants (rejections and questions). Without it, aprova can't ask
# for more information and rejects without telling the applicant.
#APROVA_SMTP_HOST=
#APROVA_SMTP_PORT=587
#APROVA_SMTP_TLS=starttls   # or tls
#APROVA_SMTP_USER=          # e.g. aprova@example.social; also the bounce mailbox
#APROVA_SMTP_PASSWORD=

# Reply-to mailbox, read over IMAPS (993) every minute for applicants' answers.
# Off when unset; then moderators paste answers with "Record answer". Keep it a
# different address from APROVA_SMTP_USER (see README > Mail).
#APROVA_IMAP_HOST=
#APROVA_IMAP_PORT=993
#APROVA_IMAP_USER=          # e.g. signups@example.social
#APROVA_IMAP_PASSWORD=

# Optional https link to the moderators' chat, shown in the panel to signed-in
# moderators only. Empty hides it.
#APROVA_TEAM_CHAT=

# --- Per-app secrets -------------------------------------------------------
# Uncomment the ones whose services you turned on in the YAML. Each name must
# match that service's token_env / digest_token_env in config.example.yaml.

# Mastodon, sign-in instance: read-only service-account token (admin:read:accounts)
# so the digest and welcome e-mail work with nobody signed in. (digest_token_env)
#APROVA_MAIN_DIGEST_TOKEN=

# Mastodon, another instance: service-account token,
# scopes admin:read:accounts admin:write:accounts. (a service's token_env)
#APROVA_SISTER_TOKEN=

# GitLab: admin token (scope: api) of a dedicated admin user.
#APROVA_GITLAB_TOKEN=

# Lemmy: JWT of a dedicated admin account.
#APROVA_LEMMY_TOKEN=

# Forgejo: site admin token (read:admin, write:admin, read:user).
#APROVA_FORGEJO_TOKEN=

# PeerTube: "username:password" of a dedicated Moderator user (password grant).
#APROVA_PEERTUBE_TOKEN=

# WriteFreely: the instance's approval_api_key.
#APROVA_WRITEFREELY_TOKEN=

# aprova-agent (pixelfed / bookwyrm / friendica): a secret shared with the agent,
# 32+ chars (openssl rand -hex 32), the same value on the agent side.
#APROVA_PHOTOS_AGENT_SECRET=

# Mattermost incoming webhook URL for a profile's digest and escalations.
#APROVA_COMMUNITY_MATTERMOST=

# Bot account token (write:statuses) for the DM digest and escalations.
#APROVA_BOT_TOKEN=
