APROVA_CONFIG=/config/aprova.yaml

# OAuth app on the sign-in instance, see README.md.
APROVA_CLIENT_ID=
APROVA_CLIENT_SECRET=
# Encrypts the moderators' tokens: openssl rand -hex 32
APROVA_ENCRYPTION_KEY=

APROVA_DB_HOST=postgres
APROVA_DB_PASSWORD=change-me
#APROVA_DB_PORT=5432
#APROVA_DB_USER=aprova
#APROVA_DB_NAME=aprova
#APROVA_DB_SSLMODE=prefer

# E-mail to applicants (rejections and questions). Without it, aprova can't ask
# for more information and rejects without telling the applicant.
#APROVA_SMTP_HOST=
#APROVA_SMTP_PORT=587
#APROVA_SMTP_TLS=starttls   # or tls
#APROVA_SMTP_USER=
#APROVA_SMTP_PASSWORD=

# Tokens named in the configuration.
#APROVA_SISTER_TOKEN=
#APROVA_GITLAB_TOKEN=
#APROVA_COMMUNITY_MATTERMOST=
#APROVA_BOT_TOKEN=
